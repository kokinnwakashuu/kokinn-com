---
import "../styles/global.css";
import site from "../data/site.json";
import idMap from "../data/wp-id-map.json";
import Sidebar from "../components/Sidebar.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
}

const {
  title = site.title,
  description = site.description,
  image = "",
  type = "website",
} = Astro.props;
const pageTitle = title === site.title ? title : `${title} | ${site.title}`;
const canonical = new URL(Astro.url.pathname, site.site).toString().replace(/\/$/, "") || site.site;
const imagePath = image || "/images/profile.png";
const ogImage = new URL(imagePath, site.site);
ogImage.pathname = ogImage.pathname
  .split("/")
  .map((part) => encodeURIComponent(part))
  .join("/");
const ogImageUrl = ogImage.toString();
const adsOn = site.enableAds;
const nav = [
  { href: "/", label: "ホーム" },
  { href: `/category/${encodeURIComponent("自己紹介")}`, label: "自己紹介" },
  { href: `/category/${encodeURIComponent("アプリ開発")}`, label: "アプリ" },
  { href: `/category/${encodeURIComponent("資格取得")}`, label: "資格" },
  { href: "/category/unity", label: "Unity" },
  { href: `/category/${encodeURIComponent("ブレヒロ")}`, label: "ブレヒロ" },
  { href: "/categories", label: "カテゴリ" },
];
---

<!doctype html>
<html lang="ja" data-google-vignette="false">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;700&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={title} />
    {adsOn && (
      <meta name="google-adsense-account" content={site.adsensePublisher} />
    )}
    {adsOn && (
      <>
        <script is:inline>
          document.addEventListener(
            "click",
            (event) => {
              const target = event.target;
              const link = target instanceof Element ? target.closest("a") : null;
              if (link) link.setAttribute("data-google-vignette", "false");
            },
            true,
          );
        </script>
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${site.adsensePublisher}`}
          crossorigin="anonymous"
          data-overlays="bottom"
        />
      </>
    )}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="/" data-google-vignette="false">
          <span class="brand-mark" aria-hidden="true">k</span>
          <span class="brand-text">
            <span class="brand-name">{site.title}</span>
            <span class="tagline">{site.description}</span>
          </span>
        </a>
        <input type="checkbox" id="nav-toggle" class="nav-toggle" />
        <label class="nav-toggle-btn" for="nav-toggle">
          <span class="nav-toggle-bars" aria-hidden="true"></span>
          <span class="sr-only">メニュー</span>
        </label>
        <nav class="nav-row" aria-label="メイン">
          {nav.map((item) => (
            <a href={item.href} data-google-vignette="false">{item.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main>
      <div class="wrap page-grid">
        <div class="main-col">
          <slot />
        </div>
        <Sidebar />
      </div>
    </main>
    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <p class="footer-brand">{site.title}</p>
          <p>{site.description}</p>
        </div>
        <nav aria-label="フッター">
          <a href={`/category/${encodeURIComponent("自己紹介")}`} data-google-vignette="false">自己紹介</a>
          <a href="/categories" data-google-vignette="false">カテゴリ一覧</a>
          <a href="/privacy" data-google-vignette="false">プライバシーポリシー</a>
          <a href="/english-schools" data-google-vignette="false">英会話スクール</a>
          <a href="/programming-schools" data-google-vignette="false">プログラミングスクール</a>
        </nav>
        <p class="footer-note">
          当サイトはAmazonアソシエイト、A8.net、Google AdSenseなどの広告・アフィリエイトプログラムに参加しています。
        </p>
      </div>
      <p class="wrap copyright">© {new Date().getFullYear()} kokinn.com</p>
    </footer>
    <script define:vars={{ idMap }}>
      const params = new URLSearchParams(window.location.search);
      const wpId = params.get("p");
      if (wpId && idMap[wpId]) {
        window.location.replace(idMap[wpId]);
      }
    </script>
  </body>
</html>
