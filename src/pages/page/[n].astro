---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";

export async function getStaticPaths() {
  const featuredCount = 1;
  const homeCount = 12;
  const perPage = 12;
  const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.localeCompare(a.data.pubDate),
  );
  const rest = posts.slice(featuredCount + homeCount);
  const pages = Math.max(2, Math.ceil(rest.length / perPage) + 1);
  return Array.from({ length: pages - 1 }, (_, i) => {
    const n = i + 2;
    const start = i * perPage;
    return {
      params: { n: String(n) },
      props: {
        n,
        pages,
        posts: rest.slice(start, start + perPage),
      },
    };
  });
}

const { n, pages, posts } = Astro.props;
---

<Base title={`記事一覧 ${n}ページ`}>
  <section class="hero">
    <p class="kicker">ARCHIVE</p>
    <h1>記事一覧</h1>
    <p class="muted">{n} / {pages} ページ</p>
  </section>
  <div class="grid">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
  <p class="pager">
    {n > 1 && <a href={n === 2 ? "/" : `/page/${n - 1}`} data-google-vignette="false">前へ</a>}
    {n < pages && <a href={`/page/${n + 1}`} data-google-vignette="false">次へ</a>}
  </p>
</Base>
