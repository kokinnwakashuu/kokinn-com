---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";

export async function getStaticPaths() {
  const perPage = 20;
  const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.localeCompare(a.data.pubDate),
  );
  const pages = Math.max(1, Math.ceil(posts.length / perPage));
  return Array.from({ length: pages }, (_, i) => {
    const n = i + 1;
    return {
      params: { n: String(n) },
      props: {
        n,
        pages,
        posts: posts.slice(i * perPage, (i + 1) * perPage),
      },
    };
  });
}

const { n, pages, posts } = Astro.props;
---

<Base title={`記事一覧 ${n}ページ`}>
  <section class="hero">
    <h1>記事一覧</h1>
    <p class="muted">{n} / {pages} ページ</p>
  </section>
  <div class="grid">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
  <p class="pager">
    {n > 1 && <a href={n === 2 ? "/" : `/page/${n - 1}`}>前へ</a>}
    {n < pages && <a href={`/page/${n + 1}`}>次へ</a>}
  </p>
</Base>
