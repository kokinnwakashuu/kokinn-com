---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const counts = new Map<string, { name: string; count: number }>();
for (const post of posts) {
  post.data.categories.forEach((name, i) => {
    const slug = post.data.categorySlugs[i] || name;
    const cur = counts.get(slug) || { name, count: 0 };
    cur.count += 1;
    counts.set(slug, cur);
  });
}
const categories = [...counts.entries()].sort((a, b) => b[1].count - a[1].count);
---

<Base title="カテゴリ一覧">
  <section class="hero">
    <h1>カテゴリ一覧</h1>
    <p class="muted">{categories.length}カテゴリ / {posts.length}本の記事</p>
  </section>
  <div class="cat-grid">
    {
      categories.map(([slug, item]) => (
        <a class="cat-tile" href={`/category/${encodeURIComponent(slug)}`}>
          <span>{item.name}</span>
          <span class="count">{item.count}</span>
        </a>
      ))
    }
  </div>
</Base>
