---
import { getCollection } from "astro:content";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const counts = new Map<string, { name: string; count: number }>();
for (const post of posts) {
  post.data.categories.forEach((name, i) => {
    const slug = post.data.categorySlugs[i] || name;
    const cur = counts.get(slug) || { name, count: 0 };
    cur.count += 1;
    counts.set(slug, cur);
  });
}
const categories = [...counts.entries()]
  .sort((a, b) => b[1].count - a[1].count)
  .slice(0, 12);
---

<aside class="sidebar">
  <section class="side-card profile-card">
    <img
      class="avatar"
      src="/images/profile.png"
      alt="kokinn"
      width="96"
      height="96"
    />
    <h2>kokinn</h2>
    <p>アプリ・ゲーム開発と資格取得の記録。会計修士（MBA）、Kaggle Code Master、行政書士、CFP®など。</p>
    <a class="side-btn" href={`/category/${encodeURIComponent("自己紹介")}`} data-google-vignette="false">プロフィールを見る</a>
    <a class="side-more" href="https://www.kaggle.com/kokinnwakashuu">Kaggle</a>
  </section>

  <section class="side-card">
    <h2>カテゴリ</h2>
    <ul class="side-cats">
      {
        categories.map(([slug, item]) => (
          <li>
            <a href={`/category/${encodeURIComponent(slug)}`} data-google-vignette="false">
              <span>{item.name}</span>
              <span class="count">{item.count}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <a class="side-more" href="/categories" data-google-vignette="false">すべてのカテゴリ</a>
  </section>
</aside>
