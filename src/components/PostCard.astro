---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const href = `/posts/${post.data.wpId}`;
const date = post.data.pubDate.slice(0, 10);
---

<article class="card">
  <a class="card-link" href={href}>
    {post.data.heroImage ? <img src={post.data.heroImage} alt="" /> : <div></div>}
    <div class="card-body">
      <p class="meta">{date}</p>
      <h2>{post.data.title}</h2>
      <p class="muted">{post.data.description}</p>
      {
        post.data.categories.length > 0 && (
          <p class="chips">
            {post.data.categories.map((name, i) => (
              <span>{name}</span>
            ))}
          </p>
        )
      }
    </div>
  </a>
</article>
